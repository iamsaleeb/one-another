# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/one_another?schema=public"

# ─────────────────────────────────────────────
# Auth.js
# ─────────────────────────────────────────────
# Generate with: npx auth secret
AUTH_SECRET="your-auth-secret"

# ─────────────────────────────────────────────
# Resend (transactional email)
# ─────────────────────────────────────────────
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
# Must be a verified sender domain in your Resend account
RESEND_FROM_EMAIL="1Another <noreply@yourdomain.com>"

# ─────────────────────────────────────────────
# Firebase Admin (push notifications)
# ─────────────────────────────────────────────
# Found in Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Use literal \n for newlines — do NOT use real line breaks
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ─────────────────────────────────────────────
# Vercel Blob (photo uploads)
# ─────────────────────────────────────────────
# Found at Vercel Dashboard → Storage → Blob → your store → .env.local
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here

# ─────────────────────────────────────────────
# Cron job (event reminder delivery)
# ─────────────────────────────────────────────
# A long random secret — must match the Authorization header set in cron-job.org
# Generate with: openssl rand -base64 32
CRON_SECRET="your-cron-secret"
