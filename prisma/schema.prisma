generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id @default(cuid())
  name                    String?
  email                   String                   @unique
  emailVerified           DateTime?
  password                String?
  image                   String?
  phone                   String?
  dateOfBirth             DateTime?
  onboardingCompleted     Boolean                  @default(false)
  role                    UserRole                 @default(ATTENDEE)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  accounts                Account[]
  adminChurches           ChurchAdmin[]            @relation("UserAdminChurches")
  churchFollows           ChurchFollower[]
  churchOrganisers        ChurchOrganiser[]        @relation("UserChurches")
  events                  Event[]                  @relation("UserEvents")
  eventAttendances        EventAttendee[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  pushTokens              PushToken[]
  questionLibrary         QuestionLibraryItem[]    @relation("UserQuestionLibrary")
  series                  Series[]                 @relation("UserSeries")
  seriesFollows           SeriesFollower[]
  sessions                Session[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Church {
  id           String            @id @default(cuid())
  name         String
  address      String?
  phone        String?
  website      String?
  description  String
  founded      String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  admins       ChurchAdmin[]     @relation("ChurchAdmins")
  followers    ChurchFollower[]
  organisers   ChurchOrganiser[] @relation("ChurchOrganisers")
  events       Event[]
  series       Series[]
  serviceTimes ServiceTime[]
}

model ChurchAdmin {
  userId    String
  churchId  String
  createdAt DateTime @default(now())
  church    Church   @relation("ChurchAdmins", fields: [churchId], references: [id], onDelete: Cascade)
  user      User     @relation("UserAdminChurches", fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, churchId])
}

model ChurchOrganiser {
  userId    String
  churchId  String
  createdAt DateTime @default(now())
  church    Church   @relation("ChurchOrganisers", fields: [churchId], references: [id], onDelete: Cascade)
  user      User     @relation("UserChurches", fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, churchId])
}

model ServiceTime {
  id       String @id @default(cuid())
  day      String
  time     String
  type     String
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
}

model Series {
  id          String           @id @default(cuid())
  name        String
  description String
  cadence     Cadence
  location    String
  host        String
  tag         String
  photoUrl    String?
  churchId    String
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  events      Event[]
  church      Church           @relation(fields: [churchId], references: [id])
  createdBy   User?            @relation("UserSeries", fields: [createdById], references: [id])
  followers   SeriesFollower[]

  @@index([churchId])
  @@index([createdById])
}

model Event {
  id                   String          @id @default(cuid())
  datetime             DateTime?
  title                String
  location             String?
  host                 String?
  tag                  String
  description          String
  photoUrl             String?
  isDraft              Boolean         @default(false)
  requiresRegistration Boolean         @default(false)
  metadata             Json            @db.JsonB
  price                String?
  cancelledAt          DateTime?
  cancellationReason   String?
  churchId             String?
  seriesId             String?
  createdById          String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  church               Church?         @relation(fields: [churchId], references: [id])
  createdBy            User?           @relation("UserEvents", fields: [createdById], references: [id])
  series               Series?         @relation(fields: [seriesId], references: [id])
  attendees            EventAttendee[]
  questions            EventQuestion[]

  @@index([datetime, isDraft])
  @@index([churchId])
  @@index([createdById])
}

model EventAttendee {
  id        String                  @id @default(cuid())
  eventId   String
  userId    String
  phone     String?
  notes     String?
  metadata  Json?                   @db.JsonB
  createdAt DateTime                @default(now())
  event     Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses EventAttendeeResponse[]

  @@unique([eventId, userId])
  @@index([userId])
}

model QuestionLibraryItem {
  id          String          @id @default(cuid())
  createdById String
  type        QuestionType
  label       String
  options     String[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  questions   EventQuestion[]
  createdBy   User            @relation("UserQuestionLibrary", fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([createdById, label, type])
  @@index([createdById])
}

model EventQuestion {
  id            String                  @id @default(cuid())
  eventId       String
  libraryItemId String?
  type          QuestionType
  label         String
  options       String[]
  required      Boolean                 @default(false)
  order         Int
  updatedAt     DateTime                @updatedAt
  responses     EventAttendeeResponse[]
  event         Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  libraryItem   QuestionLibraryItem?    @relation(fields: [libraryItemId], references: [id])

  @@index([eventId])
  @@index([eventId, order])
}

model EventAttendeeResponse {
  id              String        @id @default(cuid())
  eventAttendeeId String
  questionId      String
  answer          String?
  fileUrl         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  eventAttendee   EventAttendee @relation(fields: [eventAttendeeId], references: [id], onDelete: Cascade)
  question        EventQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([eventAttendeeId, questionId])
  @@index([questionId])
}

model ChurchFollower {
  id        String   @id @default(cuid())
  churchId  String
  userId    String
  createdAt DateTime @default(now())
  church    Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([churchId, userId])
  @@index([userId])
}

model SeriesFollower {
  id        String   @id @default(cuid())
  seriesId  String
  userId    String
  createdAt DateTime @default(now())
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([seriesId, userId])
  @@index([userId])
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, platform])
}

model NotificationPreference {
  id      String  @id @default(cuid())
  userId  String
  type    String
  enabled Boolean @default(true)
  config  Json?
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model Notification {
  id           String    @id @default(cuid())
  userId       String
  type         String
  title        String
  body         String
  data         Json?
  scheduledFor DateTime
  sentAt       DateTime?
  readAt       DateTime?
  cancelledAt  DateTime?
  dedupeKey    String?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, dedupeKey])
  @@index([scheduledFor, sentAt, cancelledAt])
  @@index([userId, sentAt, readAt])
}

enum UserRole {
  ATTENDEE
  ORGANISER
  ADMIN
}

enum Cadence {
  WEEKLY
  BIWEEKLY
  MONTHLY
  CUSTOM
}

enum QuestionType {
  SHORT_TEXT
  LONG_TEXT
  YES_NO
  MULTIPLE_CHOICE
  FILE_UPLOAD
}
