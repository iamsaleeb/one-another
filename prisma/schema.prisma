generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id @default(cuid())
  name                    String?
  email                   String                   @unique
  emailVerified           DateTime?                @map("email_verified")
  image                   String?
  phone                   String?
  dateOfBirth             DateTime?                @map("date_of_birth")
  onboardingCompleted     Boolean                  @default(false) @map("onboarding_completed")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  accounts                Account[]
  churchFollows           ChurchFollower[]
  events                  Event[]                  @relation("UserEvents")
  eventAttendances        EventAttendee[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  pushTokens              PushToken[]
  questionLibrary         QuestionLibraryItem[]    @relation("UserQuestionLibrary")
  series                  Series[]                 @relation("UserSeries")
  seriesFollows           SeriesFollower[]
  seriesStaff             SeriesStaffAssignment[]
  savedEvents             SavedEvent[]
  sessions                Session[]
  platformRoles           PlatformRoleAssignment[]
  churchMemberships       ChurchMembership[]
  eventStaff              EventStaffAssignment[]
  approvalRequests        ApprovalRequest[]      @relation("ApprovalRequests")
  approvalReviews         ApprovalRequest[]      @relation("ApprovalReviews")

  @@map("users")
}

model Account {
  userId            String   @map("user_id")
  type              String
  provider          String
  providerAccountId String   @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

model Church {
  id           String            @id @default(cuid())
  name         String
  address      String?
  phone        String?
  website      String?
  description  String
  founded      String?
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  followers    ChurchFollower[]
  events       Event[]
  series       Series[]
  serviceTimes ServiceTime[]
  memberships  ChurchMembership[]

  @@map("churches")
}

model ServiceTime {
  id       String          @id @default(cuid())
  day      DayOfWeek
  time     String
  type     ServiceTimeType
  churchId String          @map("church_id")
  church   Church          @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@map("service_times")
}

model Series {
  id          String           @id @default(cuid())
  name        String
  description String
  cadence     Cadence
  location    String
  host        String
  tag         String
  photoUrl    String?          @map("photo_url")
  churchId    String           @map("church_id")
  createdById String?          @map("created_by_id")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  events      Event[]
  church      Church                  @relation(fields: [churchId], references: [id])
  createdBy   User?                   @relation("UserSeries", fields: [createdById], references: [id])
  followers   SeriesFollower[]
  staff       SeriesStaffAssignment[]

  @@index([churchId])
  @@index([createdById])
  @@map("series")
}

model Event {
  id                   String          @id @default(cuid())
  datetime             DateTime?
  title                String
  location             String?
  host                 String?
  tag                  String
  description          String
  photoUrl             String?         @map("photo_url")
  isDraft              Boolean         @default(false) @map("is_draft")
  requiresRegistration Boolean         @default(false) @map("requires_registration")
  metadata             Json            @db.JsonB
  price                String?
  cancelledAt          DateTime?       @map("cancelled_at")
  cancellationReason   String?         @map("cancellation_reason")
  churchId             String          @map("church_id")
  seriesId             String?         @map("series_id")
  createdById          String?         @map("created_by_id")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  church               Church          @relation(fields: [churchId], references: [id])
  createdBy            User?           @relation("UserEvents", fields: [createdById], references: [id])
  series               Series?         @relation(fields: [seriesId], references: [id])
  attendees            EventAttendee[]
  questions            EventQuestion[]
  savedBy              SavedEvent[]
  staff                EventStaffAssignment[]

  @@index([datetime, isDraft])
  @@index([churchId])
  @@index([createdById])
  @@map("events")
}

model EventAttendee {
  id        String                  @id @default(cuid())
  eventId   String                  @map("event_id")
  userId    String                  @map("user_id")
  phone     String?
  notes     String?
  metadata  Json?                   @db.JsonB
  createdAt DateTime                @default(now()) @map("created_at")
  event     Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses EventAttendeeResponse[]

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_attendees")
}

model QuestionLibraryItem {
  id          String          @id @default(cuid())
  createdById String          @map("created_by_id")
  type        QuestionType
  label       String
  options     String[]
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  questions   EventQuestion[]
  createdBy   User            @relation("UserQuestionLibrary", fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([createdById, label, type])
  @@index([createdById])
  @@map("question_library_items")
}

model EventQuestion {
  id            String                  @id @default(cuid())
  eventId       String                  @map("event_id")
  libraryItemId String?                 @map("library_item_id")
  type          QuestionType
  label         String
  options       String[]
  required      Boolean                 @default(false)
  order         Int
  updatedAt     DateTime                @updatedAt @map("updated_at")
  responses     EventAttendeeResponse[]
  event         Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  libraryItem   QuestionLibraryItem?    @relation(fields: [libraryItemId], references: [id])

  @@index([eventId])
  @@index([eventId, order])
  @@map("event_questions")
}

model EventAttendeeResponse {
  id              String        @id @default(cuid())
  eventAttendeeId String        @map("event_attendee_id")
  questionId      String        @map("question_id")
  answer          String?
  fileUrl         String?       @map("file_url")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  eventAttendee   EventAttendee @relation(fields: [eventAttendeeId], references: [id], onDelete: Cascade)
  question        EventQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([eventAttendeeId, questionId])
  @@index([questionId])
  @@map("event_attendee_responses")
}

model ChurchFollower {
  id        String   @id @default(cuid())
  churchId  String   @map("church_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  church    Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([churchId, userId])
  @@index([userId])
  @@map("church_followers")
}

model SeriesFollower {
  id        String   @id @default(cuid())
  seriesId  String   @map("series_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([seriesId, userId])
  @@index([userId])
  @@map("series_followers")
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  platform  String
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, platform])
  @@map("push_tokens")
}

model NotificationPreference {
  id      String           @id @default(cuid())
  userId  String           @map("user_id")
  type    NotificationType
  enabled Boolean          @default(true)
  config  Json?
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("notification_preferences")
}

model Notification {
  id           String           @id @default(cuid())
  userId       String           @map("user_id")
  type         NotificationType
  title        String
  body         String
  data         Json?
  scheduledFor DateTime         @map("scheduled_for")
  sentAt       DateTime?        @map("sent_at")
  readAt       DateTime?        @map("read_at")
  cancelledAt  DateTime?        @map("cancelled_at")
  dedupeKey    String?          @map("dedupe_key")
  createdAt    DateTime         @default(now()) @map("created_at")
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, dedupeKey])
  @@index([scheduledFor, sentAt, cancelledAt])
  @@index([userId, sentAt, readAt])
  @@map("notifications")
}

model SavedEvent {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  eventId   String   @map("event_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@map("saved_events")
}

model PlatformRoleAssignment {
  userId     String       @map("user_id")
  role       PlatformRole
  assignedAt DateTime     @default(now()) @map("assigned_at")
  assignedBy String?      @map("assigned_by")

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([userId])
  @@map("platform_role_assignments")
}

model ChurchMembership {
  userId     String     @map("user_id")
  churchId   String     @map("church_id")
  role       ChurchRole
  assignedAt DateTime   @default(now()) @map("assigned_at")
  assignedBy String?    @map("assigned_by")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  church     Church     @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@id([userId, churchId])
  @@index([userId])
  @@index([churchId])
  @@map("church_memberships")
}

model EventStaffAssignment {
  userId     String    @map("user_id")
  eventId    String    @map("event_id")
  role       EventRole
  assignedAt DateTime  @default(now()) @map("assigned_at")
  assignedBy String?   @map("assigned_by")

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@map("event_staff_assignments")
}

model SeriesStaffAssignment {
  userId     String     @map("user_id")
  seriesId   String     @map("series_id")
  role       SeriesRole
  assignedAt DateTime   @default(now()) @map("assigned_at")
  assignedBy String?    @map("assigned_by")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([userId, seriesId])
  @@index([userId])
  @@index([seriesId])
  @@map("series_staff_assignments")
}

enum PlatformRole {
  PLATFORM_ADMIN

  @@map("platform_role")
}

enum ChurchRole {
  CHURCH_ADMIN
  EVENT_MANAGER
  EVENT_CREATOR

  @@map("church_role")
}

enum EventRole {
  EVENT_MANAGER
  EVENT_EDITOR

  @@map("event_role")
}

enum SeriesRole {
  SERIES_MANAGER
  SERIES_SESSION_CREATOR

  @@map("series_role")
}

enum Cadence {
  WEEKLY
  BIWEEKLY
  MONTHLY
  CUSTOM

  @@map("cadence")
}

enum QuestionType {
  SHORT_TEXT
  LONG_TEXT
  YES_NO
  MULTIPLE_CHOICE
  FILE_UPLOAD

  @@map("question_type")
}

enum NotificationType {
  EVENT_REMINDER
  NEW_SERIES_SESSION
  EVENT_CANCELLED
  ROLE_REQUEST_RECEIVED
  ROLE_REQUEST_OUTCOME

  @@map("notification_type")
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY

  @@map("day_of_week")
}

enum ServiceTimeType {
  MORNING
  AFTERNOON
  EVENING
  MIDWEEK
  YOUTH
  OTHER

  @@map("service_time_type")
}

enum ResourceType {
  EVENT
  SERIES
  CHURCH

  @@map("resource_type")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
  REVOKED

  @@map("approval_status")
}

model ApprovalRequest {
  id            String         @id @default(cuid())
  requesterId   String         @map("requester_id")
  resourceType  ResourceType   @map("resource_type")
  resourceId    String         @map("resource_id")
  requestedRole String         @map("requested_role")
  message       String?
  status        ApprovalStatus @default(PENDING)
  reviewedBy    String?        @map("reviewed_by")
  reviewedAt    DateTime?      @map("reviewed_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  requester     User           @relation("ApprovalRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewer      User?          @relation("ApprovalReviews", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@unique([requesterId, resourceType, resourceId])
  @@index([resourceType, resourceId, status])
  @@map("approval_requests")
}
